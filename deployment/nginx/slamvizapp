server {
  listen 5000;
  listen [::]:5000;
  server_name gpu09-dt,localhost;

  location / {
      include uwsgi_params;
      uwsgi_pass unix:/home/arthurf/dvs/slamvizapp/deployment/slamvizapp.sock;
  }
 location /static {
  root /home/arthurf/dvs/slamvizapp/slamvizapp/;
  access_log off;
 }
 location /s/ {
  alias /home/arthurf/ci/dvs/psp_swip/;
 }
 location /ss/ {
  alias /net/f2/algo_archive/PTAM_Results/; 
 }

}

server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name gpu09-dt,localhost;

  # ssl_dhparam  /etc/nginx/ssl/dhparam.pem;
  ssl_certificate /etc/nginx/ssl/gpu09-dt.crt;
  ssl_certificate_key /etc/nginx/ssl/gpu09-dt.key;

 location /static {
  root /home/arthurf/dvs/slamvizapp/slamvizapp/;
 }
 location /s/ {
  alias /home/arthurf/ci/dvs/psp_swip/;
 }
 location /ss/ {
  alias /net/f2/algo_archive/PTAM_Results/; 
 }

 location / {
      include uwsgi_params;
      uwsgi_pass unix:/home/arthurf/dvs/slamvizapp/deployment/slamvizapp.sock;
  }

}

server {
   listen         80;
   listen    [::]:80;
   server_name    gpu09-dt;
   return         301 https://$server_name$request_uri;
}
