server {
  listen 5000;
  listen [::]:5000;
  server_name qa, dvs, gpu09-dt, planet31, planet33, localhost;

  # CSS and Javascript
  location ~* \.(?:css|js)$ {
    expires 1y;
    access_log off;
    add_header Cache-Control "public";
    root /slamvizapp/slamvizapp-webapp/build;
    try_files $uri $uri/index.html $uri.html /index.html;
  }

  location / {
    root /slamvizapp/slamvizapp-webapp/build;
    try_files $uri $uri/index.html $uri.html /index.html;
  }

  location ^~ /api {
      include uwsgi_params;
      uwsgi_pass unix:/slamvizapp/deployment/slamvizapp.sock;
      uwsgi_read_timeout 300;
  }

  location ^~ /webhook {
      include uwsgi_params;
      uwsgi_pass unix:/slamvizapp/deployment/slamvizapp.sock;
  }

  location ^~ /admin {
      include uwsgi_params;
      uwsgi_pass unix:/slamvizapp/deployment/slamvizapp.sock;
  }

 location ^~ /s/ {
  alias /home/arthurf/ci/;
  autoindex on;
  access_log off;
 }

 location ^~ /s/home/ {
  alias /home/;
  autoindex on;
  access_log off;
 }

 location ^~ /s/home/arthurf {
    deny all; 
 }

 location ^~ /s/algo_archive/ {
  alias /net/f2/algo_archive/; 
  autoindex on;
  access_log off;
 }

 location ^~ /s/algo_data/ {
  alias /stage/algo_data/;
  autoindex on;
  access_log off;
 }

 location ^~ /s/net/f2/algo_archive/ {
  alias /net/f2/algo_archive/; 
  autoindex on;
  access_log off;
 }

 location ^~ /s/stage/algo_data/ {
  alias /stage/algo_data/;
  autoindex on;
  access_log off;
 }

}


server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
