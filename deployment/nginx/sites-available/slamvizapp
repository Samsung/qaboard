server {
  listen 5000;
  listen [::]:5000;
  server_name dvs, gpu09-dt, planet31, planet33, localhost;

  location / {
    root /slamvizapp/slamvizapp-webapp/build;
    try_files $uri $uri/index.html $uri.html /index.html;
  }

  location ^~ /api {
      include uwsgi_params;
      uwsgi_pass unix:/slamvizapp/deployment/slamvizapp.sock;
      uwsgi_read_timeout 300;
  }

  location ^~ /webhook {
      include uwsgi_params;
      uwsgi_pass unix:/slamvizapp/deployment/slamvizapp.sock;
  }

 location ^~ /s/ {
  alias /home/arthurf/ci/dvs/psp_swip/;
  access_log off;
  autoindex on;
 }

 location ^~ /ss/ {
  alias /net/f2/algo_archive/PTAM_Results/; 
  access_log off;
  autoindex on;
 }

}


server {
  listen 443 ssl http2;
  listen [::]:443 ssl http2;
  server_name dvs, gpu09-dt, planet31, planet33, localhost;

  # ssl_dhparam  /etc/nginx/ssl/dhparam.pem;
  ssl_certificate /slamvizapp/deployment/nginx/ssl/dvs/dvs.chain.pem;
  ssl_certificate_key /slamvizapp/deployment/nginx/ssl/dvs/dvs.key;
  # ssl_certificate_key /slamvizapp/deployment/nginx/ssl/dvs/dvs-key.pem;

  location / {
    root /slamvizapp/slamvizapp-webapp/build;
    try_files $uri $uri/index.html $uri.html /index.html;
  }

  location ^~ /api {
      include uwsgi_params;
      uwsgi_pass unix:/slamvizapp/deployment/slamvizapp.sock;
      uwsgi_read_timeout 300;
  }

  location ^~ /webhook {
      include uwsgi_params;
      uwsgi_pass unix:/slamvizapp/deployment/slamvizapp.sock;
  }

 location ^~ /s/ {
  alias /home/arthurf/ci/dvs/psp_swip/;
  access_log off;

 }

 location ^~ /ss/ {
  alias /net/f2/algo_archive/PTAM_Results/; 
  access_log off;
 }

}

server {
   listen         80;
   listen    [::]:80;
   server_name    dvs,planet31,gpu09-dt;
   return         302 https://$server_name$request_uri;
}
