{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "import", "jsx-a11y", "vitest", "oxc", "unicorn"],
  "env": { "browser": true, "es2024": true },
  "categories": { "correctness": "warn" },
  "rules": {
    "no-undef": "error",
    "no-dupe-keys": "error",
    "import/named": "error",
    "import/default": "error",
    "react/jsx-no-undef": "error",
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "no-unused-vars": "error",
    "jsx-a11y/no-autofocus": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/label-has-associated-control": ["warn", { "controlComponents": ["HTMLSelect"] }],
    "no-extra-boolean-cast": "off"
  },
  "overrides": [
    { "files": ["vite.config.js", "vite.image-viewer.config.js", "playwright.config.js", "releaseNotes.js", "e2e/**"], "env": { "node": true } },
    { "files": ["**/*.test.{js,jsx,ts,tsx}"], "env": { "vitest": true } }
  ],
  "ignorePatterns": ["build/**", "build-image-viewer/**", "src/viewers/tof/*Controls.js", "src/viewers/tof/PCDLoader.js"]
}
