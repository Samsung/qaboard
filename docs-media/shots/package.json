{
  "name": "qaboard-docs-media-shots",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "capture": "playwright test --project stills --project clips --project stills-dark --project clips-dark",
