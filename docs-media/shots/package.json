    "typecheck": "tsc"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "github-markdown-css": "5.9.0",
    "marked": "15.0.12",
    "openseadragon": "6.1.1",
    "plotly.js-dist-min": "3.7.0",
    "typescript": "7.0.2"
  }
}
