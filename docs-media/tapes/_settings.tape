# The settings every tape starts with: Source "tapes/_settings.tape" (README.md#terminal-tapes).
# Tapes run from docs-media/ with tapes/record.py, which sets the prompt ($ ), HOME, PATH and the demo world's env.
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set Width 1280
Set Height 720
Set Padding 24
Set Framerate 30
Set TypingSpeed 35ms
Set CursorBlink false
# Blueprint's dark palette, like the web app's dark theme
Set Theme { "name": "QA-Board", "background": "#1C2127", "foreground": "#E5E8EB", "cursor": "#8ABBFF", "selection": "#2D72D2", "black": "#1C2127", "red": "#E76A6E", "green": "#32A467", "yellow": "#F0B726", "blue": "#4C90F0", "magenta": "#BDADFF", "cyan": "#3FA6DA", "white": "#DCE0E5", "brightBlack": "#738091", "brightRed": "#FA999C", "brightGreen": "#72CA9B", "brightYellow": "#FBD065", "brightBlue": "#8ABBFF", "brightMagenta": "#D6CCFF", "brightCyan": "#68C1EE", "brightWhite": "#F6F7F9" }
