# Production at SIRC: https://qa, deployed on the "qa" host from /home/ispq/qaboard_prod
#   deployments/deploy.py deployments/sirc/production.env status|up|rollback|compose ...
#   docker compose --env-file deployments/sirc/production.env ps
# Secrets are NOT here: they are in .env and deployments/sirc/.env on the host (see deployments/sirc/.env.sirc.example)

# Must match the existing project, or compose would start with new, empty volumes (database!)
COMPOSE_PROJECT_NAME=qaboard_prod
COMPOSE_FILE=docker-compose.yml:production.yml:deployments/sirc/sirc.yml:deployments/sirc/prod.yml

# 2 replicas with half the uwsgi processes each: same capacity, but survives a crash and allows rolling deploys
QABOARD_BACKEND_REPLICAS=2
QABOARD_UWSGI_PROCESSES=8
QABOARD_UWSGI_CHEAPER=4
QABOARD_UWSGI_CHEAPER_INITIAL=8

# Autofs: mount what we bind in containers, see at-sirc-before-up.py
QABOARD_DEPLOY_PRE_HOOK=./at-sirc-before-up.py --if-stale > /dev/null
