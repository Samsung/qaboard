# Staging at SIRC: http://alginfra1:7159, deployed on alginfra1 from /home/ispq/qaboard_staging
# The production images and configuration, with its own database. Every commit on master is deployed here first.
#   deployments/deploy.py deployments/sirc/staging.env status|up|seed-db|compose ...
COMPOSE_PROJECT_NAME=qaboard_staging
COMPOSE_FILE=docker-compose.yml:production.yml:deployments/sirc/sirc.yml:deployments/sirc/staging.yml

QABOARD_BACKEND_REPLICAS=1
QABOARD_UWSGI_PROCESSES=4
QABOARD_UWSGI_CHEAPER=2
QABOARD_UWSGI_CHEAPER_INITIAL=2

# Ports, not to conflict with other services on alginfra1 (same as the former qaboard_ci instance)
QABOARD_PROXY_PORT_HTTP=7159
QABOARD_PORT_HTTPS=9944
QABOARD_PORT_HTTP=7151
QABOARD_EXTRA_SIRC_PORT_1=9000
QABOARD_EXTRA_SIRC_PORT_2=9002
QABOARD_EXPOSED_DB_PORT=7432

QABOARD_DEPLOY_PRE_HOOK=./at-sirc-before-up.py > /dev/null

# seed-db copies production's recent data (the full database is big): projects/users/... and the commits
# of the last QABOARD_SEED_DAYS days with their batches and outputs. Read-only for production.
# The password is the compose default (services.db in docker-compose.yml): override it from the shell if it changed.
QABOARD_SEED_SOURCE=postgresql://qaboard:password@qa:5434/qaboard
QABOARD_SEED_DAYS=30
