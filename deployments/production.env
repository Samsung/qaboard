# A single-host production deployment, to use as-is or copy for your site (see deployments/sirc/production.env)
#   deployments/deploy.py deployments/production.env up --version 1.2.0 --init  # first time, with a release's images
#   deployments/deploy.py deployments/production.env up --version 1.2.1        # upgrades, with zero downtime
#   deployments/deploy.py deployments/production.env up --build                # or build the images from this checkout
#   deployments/deploy.py deployments/production.env compose logs -f backend
COMPOSE_PROJECT_NAME=qaboard
COMPOSE_FILE=docker-compose.yml:production.yml

# Where the images are pulled from (see docker-compose.yml), e.g. a mirror, or a fork's ghcr.io/<owner>/qaboard
# QABOARD_IMAGE=ghcr.io/samsung/qaboard

# Several replicas survive crashes and allow zero-downtime deploys.
# uwsgi processes are per replica: divide them to keep the same capacity.
QABOARD_BACKEND_REPLICAS=2
QABOARD_UWSGI_PROCESSES=8
QABOARD_UWSGI_CHEAPER=4
QABOARD_UWSGI_CHEAPER_INITIAL=8
